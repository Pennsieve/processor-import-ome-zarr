# Environment
ENVIRONMENT=local

# Directory configuration
INPUT_DIR=/data/input
OUTPUT_DIR=/data/output

# Pennsieve API configuration
PENNSIEVE_API_HOST=https://api.pennsieve.net
PENNSIEVE_API_HOST2=https://api2.pennsieve.net

# Authentication: prefer pre-supplied Cognito tokens (production path),
# fall back to API key/secret (local development path).
# SESSION_TOKEN=
# REFRESH_TOKEN=
# PENNSIEVE_API_KEY=
# PENNSIEVE_API_SECRET=

# Workflow instance (required for production)
# WORKFLOW_INSTANCE_ID=

# Import settings
IMPORTER_ENABLED=false

# Viewer asset configuration
ASSET_TYPE=ome-zarr
